@inherits LayoutComponentBase
@using Trainer.Web.Islands
@using Microsoft.Extensions.Options
@using Trainer.Web.Startup
@inject IStringLocalizer<SharedResource> L
@inject SitePaths Paths
@inject IOptions<AppOptions> App

@if (App.Value.Edition == SiteEdition.Static)
{
    <SiteUpdatedBanner />
}
<a class="skip-link" href="@SkipLinkHref">@L["Nav.SkipToContent"]</a>
<header class="site-header">
    <div class="container site-header__inner">
        <a class="brand" href="@HomeHref" aria-label="@L["Nav.HomeLabel"]">
            <span class="brand__prompt" aria-hidden="true">&gt;</span>@L["Site.Name"]
        </a>
        <SiteNav />
        <div class="site-header__tools">
            <LanguageSwitcher />
            <AccountControls />
            <button type="button" class="theme-toggle" id="theme-toggle" aria-label="@L["Theme.Toggle"]">
                <span class="theme-toggle__icon" aria-hidden="true"></span>
            </button>
        </div>
    </div>
</header>
<main id="main" class="container main">
    @Body
</main>
<footer class="site-footer">
    <div class="container site-footer__inner">
        <span>@L["Footer.License"]</span>
        <a href="@AboutHref">@L["Footer.About"]</a>
    </div>
</footer>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private static string Current => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    private string HomeHref => Paths.Page("/" + Current);

    private string AboutHref => Paths.Page($"/{Current}/about");

    // Island pages carry a <base> element for the WebAssembly runtime, against which a bare "#main" would resolve to the
    // site root and leave the page. Island pages are never output-cached, so writing this request's own URL into them is safe.
    private string SkipLinkHref =>
        HttpContext is { } http && InteractiveIslandPageAttribute.IsMatched(http)
            ? Paths.CurrentPage(http.Request) + "#main"
            : "#main";
}
