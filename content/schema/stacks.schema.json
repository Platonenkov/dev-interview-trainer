{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stacks",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "key": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "maxLength": 80
      },
      "locales": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          },
          "required": [
            "title",
            "description"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "key",
      "locales"
    ],
    "additionalProperties": false
  }
}
