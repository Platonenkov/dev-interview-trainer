@inject IStringLocalizer<ClientResource> L
@inject NavigationManager Navigation
@inject IslandLinks Links
@* The static edition has no server to receive a rating or a report, so a report is a prefilled GitHub issue. *@
<p class="report-link">
    <a href="@ProblemReportLink.Build(IssuesNewUrl, Question.Id, Question.Slug, Culture, PageUrl())" rel="noopener noreferrer" target="_blank">@L["Report.Problem"]</a>
</p>

@code {
    [Parameter, EditorRequired]
    public QuestionDto Question { get; set; } = null!;

    [Parameter, EditorRequired]
    public string Culture { get; set; } = "";

    [Parameter, EditorRequired]
    public string Stack { get; set; } = "";

    [Parameter, EditorRequired]
    public string IssuesNewUrl { get; set; } = "";

    // The island page's base is the public prefix, so the relative page link resolves to the canonical question URL.
    private string PageUrl() =>
        new Uri(new Uri(Navigation.BaseUri), Links.Page(Culture, Stack, ["questions", Question.Slug])).AbsoluteUri;
}
