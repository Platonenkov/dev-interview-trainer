@inject IStringLocalizer<SharedResource> L

@* Revealed by RecoveryScript when a boot-critical file failed to load. Plain markup on purpose: it has to work when the
   stylesheet or islands-start.js is the file that is missing. The script sets the link's href. *@
<div id="site-updated" class="site-updated" role="alert" hidden>
    @L["Recovery.Text"]
    <a data-reload>@L["Recovery.Reload"]</a>
</div>
