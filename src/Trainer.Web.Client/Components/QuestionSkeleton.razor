@inject IStringLocalizer<ClientResource> L

@* Stands in for the question card while the next question loads. Its size comes from the stylesheet (qcard--skeleton),
   so the screen does not jump when the question arrives.
   The announcement is LoadingAnnouncement, rendered by the island so the live region outlasts the skeleton. *@
<div class="qcard qcard--skeleton" aria-busy="true">
    <p class="qcard__loading" aria-hidden="true">@L["State.LoadingNext"]</p>
    <span class="qcard__bar qcard__bar--title" aria-hidden="true"></span>
    <span class="qcard__bar" aria-hidden="true"></span>
    <span class="qcard__bar" aria-hidden="true"></span>
    <span class="qcard__bar qcard__bar--short" aria-hidden="true"></span>
</div>
