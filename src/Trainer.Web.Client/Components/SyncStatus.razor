@using Trainer.Web.Client.Sync
@implements IDisposable
@inject OutboxSyncService Sync
@inject IStringLocalizer<ClientResource> L

@* Shown by islands after a flush-before-fetch that did not finish: their server data lacks these answers. *@
@if (Sync.Pending > 0)
{
    <p class="sync-status" role="status">
        @string.Format(
            CultureInfo.CurrentCulture,
            L[PluralForms.Key("Sync.Pending", Sync.Pending, CultureInfo.CurrentUICulture)].Value,
            Sync.Pending)
    </p>
}

@code {
    protected override void OnInitialized() => Sync.Changed += OnChanged;

    public void Dispose() => Sync.Changed -= OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
}
