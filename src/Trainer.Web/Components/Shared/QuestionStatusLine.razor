@using Trainer.Application.Progress

@if (SignedIn)
{
    <div class="question__status"><StatusChip Status="Status" /></div>
}

@code {
    /// <summary>False for an anonymous visitor: nothing is rendered, so the cached public HTML does not change.</summary>
    [Parameter]
    public bool SignedIn { get; set; }

    [Parameter]
    public QuestionStatus? Status { get; set; }
}
