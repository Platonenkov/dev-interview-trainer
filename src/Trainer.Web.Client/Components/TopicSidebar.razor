@inject IStringLocalizer<ClientResource> L
@inject IslandLinks Links

@* Below 1024 px a native details drawer (no script); from 1024 px the sidebar is always open (islands.css). Links are
   full page loads: every island page starts its own runtime (ADR 0009). *@
<details class="side">
    <summary class="side__toggle">@L["Sidebar.Topics"]</summary>
    <nav class="side__panel" aria-label="@L["Sidebar.Topics"]">
        <p class="side__group" aria-hidden="true">@L["Sidebar.Topics"]</p>
        <ul class="side__list">
            @foreach (TopicDto topic in Topics)
            {
                TopicProgressDto? progress = Progress?.Topics.FirstOrDefault(p => string.Equals(p.Topic, topic.Key, StringComparison.Ordinal));
                bool current = string.Equals(topic.Key, CurrentTopic, StringComparison.Ordinal);
                <li>
                    <a class="side__item"
                       href="@Links.Page(Culture, Stack, ["practice"], "topic=" + Uri.EscapeDataString(topic.Key))"
                       aria-current="@(current ? "true" : null)"
                       title="@topic.Title"
                       data-enhance-nav="false">
                        <span class="side__name">@topic.Title</span>
                        @if (progress is { LiveQuestions: > 0 })
                        {
                            <span class="side__known" aria-hidden="true">@Percent(progress)%</span>
                            <meter class="side__meter" min="0" max="@progress.LiveQuestions" value="@progress.Known" aria-hidden="true"></meter>
                            <span class="visually-hidden">@L["Sidebar.Known", progress.Known, progress.LiveQuestions]</span>
                        }
                    </a>
                </li>
            }
        </ul>
        @if (Progress is not null)
        {
            <p class="side__group" aria-hidden="true">@L["Sidebar.Modes"]</p>
            <ul class="side__list">
                <li><a class="side__item" href="@Links.Page(Culture, Stack, ["mock"])" data-enhance-nav="false">@L["Sidebar.Mock"]</a></li>
                <li>
                    <a class="side__item" href="@Links.Page(Culture, Stack, ["review"])" data-enhance-nav="false">
                        @string.Format(CultureInfo.CurrentCulture, L["Sidebar.Review"].Value, Progress.DueNow)
                    </a>
                </li>
            </ul>
        }
    </nav>
</details>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<TopicDto> Topics { get; set; } = [];

    /// <summary>Progress for a visitor who has any; others see topic names only.</summary>
    [Parameter]
    public IslandProgress? Progress { get; set; }

    [Parameter]
    public string? CurrentTopic { get; set; }

    [Parameter, EditorRequired]
    public string Culture { get; set; } = "";

    [Parameter, EditorRequired]
    public string Stack { get; set; } = "";

    private static int Percent(TopicProgressDto progress) => progress.Known * 100 / progress.LiveQuestions;
}
