@inject IStringLocalizer<ClientResource> L

<div class="typed">
    <label class="typed__label" for="@InputId">@L["Question.Typed"]</label>
    @* Output can span lines, so Enter is a newline here; shortcuts.js leaves textareas alone. *@
    <textarea id="@InputId"
              class="typed__input"
              rows="3"
              spellcheck="false"
              autocapitalize="off"
              autocomplete="off"
              readonly="@Attempt.IsFrozen"
              value="@Attempt.Typed"
              @oninput="OnInputAsync"></textarea>
</div>

@code {
    [Parameter, EditorRequired]
    public QuestionAttempt Attempt { get; set; } = null!;

    [Parameter]
    public EventCallback Changed { get; set; }

    private string InputId => "typed-" + Attempt.ClientAnswerId;

    private Task OnInputAsync(ChangeEventArgs e)
    {
        Attempt.SetTyped(e.Value as string ?? "");
        return Changed.InvokeAsync();
    }
}
