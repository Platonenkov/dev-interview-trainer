@using Trainer.Application.Catalog
@using Trainer.Domain.Questions
@inject IStringLocalizer<SharedResource> L

<div class="row">
    <LevelChip Level="Row.Level" />
    <div>
        <a class="row__title" href="/@Culture/@Stack/questions/@Row.Slug">@Row.Title</a>
        <div class="row__meta">@Meta</div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public CatalogRow Row { get; set; } = null!;

    [Parameter, EditorRequired]
    public string Culture { get; set; } = "";

    [Parameter, EditorRequired]
    public string Stack { get; set; } = "";

    private string Meta => string.Join(" · ", new[] { Row.TopicTitle, L["Type." + QuestionTypeKeys.ToKey(Row.Type)].Value }.Concat(Row.Tags));
}
