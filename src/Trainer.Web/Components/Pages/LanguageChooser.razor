@using Trainer.Domain.Keys
@using Trainer.Web.Startup
@using Trainer.Web.OpenGraph
@using Trainer.Web.Seo
@inject IStringLocalizer<SharedResource> L
@inject SitePaths Paths
@inject SiteUrls Urls
@inject OgImageLinks ImageLinks
<!DOCTYPE html>
<html lang="en" data-edition="static">
<head>
    <StaticHeadMeta />
    @* Right after the policy and the other metas: the encoding must be declared within the first 1024 bytes. *@
    <meta charset="utf-8" />
    <script>@((MarkupString)RecoveryScript.Source)</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@L["Site.Name"]</title>
    @* The root picks a language, so search engines get it as the x-default of the culture home pages (HreflangDefault)
       rather than a noindex page. A shared root link (Telegram, Slack, social networks) gets the English site card: the
       page itself is English, and the language pages carry their own cards. *@
    <link rel="canonical" href="@Urls.Absolute(HttpContext?.Request, HreflangDefault.RootPath)" />
    @foreach (CultureKey culture in CultureKey.Supported)
    {
        <link rel="alternate" hreflang="@culture.Value" href="@Urls.Absolute(HttpContext?.Request, "/" + culture.Value)" />
    }
    <link rel="alternate" hreflang="x-default" href="@Urls.Absolute(HttpContext?.Request, HreflangDefault.RootPath)" />
    <meta name="description" content="@L["Home.Tagline"]" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@L["Home.Title"]" />
    <meta property="og:description" content="@L["Home.Tagline"]" />
    <meta property="og:url" content="@Urls.Absolute(HttpContext?.Request, "/")" />
    <meta property="og:site_name" content="@L["Site.Name"]" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content="@ImageLinks.SiteUrl(CultureKey.Default, HttpContext?.Request)" />
    <meta property="og:image:width" content="@OgCardRenderer.Width" />
    <meta property="og:image:height" content="@OgCardRenderer.Height" />
    <meta property="og:image:alt" content="@L["Home.Title"]" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="stylesheet" href="@Paths.Asset(Assets["css/tokens.css"])" data-recover />
    <link rel="stylesheet" href="@Paths.Asset(Assets["css/site.css"])" data-recover />
</head>
<body>
    <SiteUpdatedBanner />
    @* No JavaScript: both links work as they are. root-chooser.js always leaves this page: to the stored language, else the browser's, else English. *@
    <main class="container main">
        <h1>@L["Site.Name"]</h1>
        <nav class="lang-switch" aria-label="@L["Language.Label"]">
            @foreach (CultureKey culture in CultureKey.Supported)
            {
                <a href="@Paths.Page("/" + culture.Value)" lang="@culture.Value" hreflang="@culture.Value">@L[culture.Value == "ru" ? "Language.SwitchToRu" : "Language.SwitchToEn"]</a>
            }
        </nav>
    </main>
    <script src="@Paths.Asset(Assets["js/root-chooser.js"])" data-base="@Paths.BaseHref"></script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }
}
