@inherits LayoutComponentBase
@using Trainer.Web.Islands
@inject IStringLocalizer<SharedResource> L

<a class="skip-link" href="@SkipLinkHref">@L["Nav.SkipToContent"]</a>
<header class="site-header">
    <div class="container site-header__inner">
        <a class="brand" href="/@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" aria-label="@L["Nav.HomeLabel"]">
            <span class="brand__prompt" aria-hidden="true">&gt;</span>@L["Site.Name"]
        </a>
        <div class="site-header__tools">
            <LanguageSwitcher />
            <AccountControls />
            <button type="button" class="theme-toggle" id="theme-toggle" aria-label="@L["Theme.Toggle"]">
                <span class="theme-toggle__icon" aria-hidden="true"></span>
            </button>
        </div>
    </div>
</header>
<main id="main" class="container main">
    @Body
</main>
<footer class="site-footer">
    <div class="container site-footer__inner">
        <span>@L["Footer.License"]</span>
        <a href="/@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName/about">@L["Footer.About"]</a>
    </div>
</footer>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // Island pages carry <base href="/"> for the WebAssembly runtime, against which a bare "#main" would mean "/#main"
    // and leave the page. Island pages are never output-cached, so writing this request's own URL into them is safe.
    private string SkipLinkHref =>
        HttpContext is { } http && InteractiveIslandPageAttribute.IsMatched(http)
            ? http.Request.Path.ToUriComponent() + http.Request.QueryString.ToUriComponent() + "#main"
            : "#main";
}
