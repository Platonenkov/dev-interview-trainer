@using Trainer.Application.Catalog
@using Trainer.Web.Catalog
@inject IStringLocalizer<SharedResource> L
@inject SitePaths Paths

@if (Page.PageCount > 1)
{
    <nav class="pager" aria-label="@L["Pager.Label"]">
        @if (Page.Page > 1)
        {
            <a rel="prev" href="@LinkTo(Page.Page - 1)">← @L["Pager.Prev"]</a>
        }
        else
        {
            <span class="pager__off">← @L["Pager.Prev"]</span>
        }
        <span>@L["Pager.Status", Page.Page, Page.PageCount]</span>
        @if (Page.Page < Page.PageCount)
        {
            <a rel="next" href="@LinkTo(Page.Page + 1)">@L["Pager.Next"] →</a>
        }
        else
        {
            <span class="pager__off">@L["Pager.Next"] →</span>
        }
    </nav>
}

@code {
    [Parameter, EditorRequired]
    public CatalogQuery Query { get; set; } = null!;

    [Parameter, EditorRequired]
    public CatalogPage Page { get; set; } = null!;

    private string LinkTo(int page) => Paths.Page(CatalogQueryParser.ToUrl(Query with { Page = page }));
}
