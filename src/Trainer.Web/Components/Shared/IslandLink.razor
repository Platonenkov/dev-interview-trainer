@inject SitePaths Paths
@* A link from a public page into an island page. It is always a full page load (ADR 0009). With PreloadRuntime it
   names the runtime's first downloads, which runtime-preload.js prefetches when the link is hovered, focused or touched
   (spec 8.2); the public page itself never loads them. *@
<a class="@Class" href="@Paths.Page(Href)" rel="@Rel" data-enhance-nav="false" data-preload-runtime="@(PreloadRuntime ? RuntimeUrls : null)">@ChildContent</a>

@code {
    [Parameter, EditorRequired]
    public string Href { get; set; } = "";

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Rel { get; set; }

    /// <summary>Practice and Mock entry points; Review and the profile need a sign-in first, so their runtime is not guessed.</summary>
    [Parameter]
    public bool PreloadRuntime { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    // The same fingerprinted URLs the island page references, so the prefetched copies are the ones it asks for.
    private string RuntimeUrls => $"{Paths.Asset(Assets["_framework/blazor.web.js"])} {Paths.Asset(Assets["_framework/dotnet.js"])}";
}
