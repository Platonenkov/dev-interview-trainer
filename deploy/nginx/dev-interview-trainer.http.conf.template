# Bootstrap site: port 80 only, used until the first certificate exists.
# It serves the ACME HTTP-01 challenge and nothing else.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 404;
    }
}
