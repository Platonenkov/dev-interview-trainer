<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UserSecretsId>5d1c6f0e-7b0a-4f3e-9b8e-2a6c1d9e4f71</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Trainer.Infrastructure/Trainer.Infrastructure.csproj" />
    <ProjectReference Include="../Trainer.Application/Trainer.Application.csproj" />
    <ProjectReference Include="../Trainer.Contracts/Trainer.Contracts.csproj" />
    <ProjectReference Include="../Trainer.Web.Client/Trainer.Web.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Referenced directly so the transitive 10.0.0 from the Telegram package is lifted to the current patch. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Telegram.OpenIdConnect.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <!-- MIT. The Linux assets are the variant without fontconfig, so the slim runtime image needs no extra packages. -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="OpenGraph/Fonts/*.ttf" LogicalName="Trainer.Web.OpenGraph.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
