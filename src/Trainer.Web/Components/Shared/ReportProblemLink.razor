@using Microsoft.Extensions.Options
@using Trainer.Contracts
@using Trainer.Web.Startup
@inject IStringLocalizer<SharedResource> L
@inject IOptions<AppOptions> App
@* The static edition's replacement for the feedback forms: it has no server, so a report is a prefilled GitHub issue. *@
<p class="report-link">
    <a href="@ProblemReportLink.Build(App.Value.StaticSite.IssuesNewUrl, QuestionId, Slug, Culture, PageUrl)" rel="noopener noreferrer" target="_blank">@L["Report.Problem"]</a>
</p>

@code {
    [Parameter, EditorRequired]
    public string QuestionId { get; set; } = "";

    [Parameter, EditorRequired]
    public string Slug { get; set; } = "";

    [Parameter, EditorRequired]
    public string Culture { get; set; } = "";

    /// <summary>The question page's absolute canonical URL.</summary>
    [Parameter, EditorRequired]
    public string PageUrl { get; set; } = "";
}
