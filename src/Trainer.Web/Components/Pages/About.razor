@page "/{Culture}/about"
@using Microsoft.AspNetCore.OutputCaching
@attribute [OutputCache(PolicyName = "public")]
@using Trainer.Domain.Keys
@using Trainer.Web.Seo
@inject IStringLocalizer<SharedResource> L

@if (_culture is { } culture)
{
    <SeoHead Title="@L["About.Title"]"
             Description="@L["About.Description"]"
             CanonicalPathAndQuery="@PathFor(culture)"
             AvailableCultures="CultureKey.Supported"
             PathForCulture="PathFor" />
    <BreadcrumbJsonLd Items="Breadcrumbs(culture)" />
}

<article class="prose">
    <h1>@L["About.Heading"]</h1>
    <h2>@L["About.What.Heading"]</h2>
    <p>@L["About.What.Text"]</p>
    <h2>@L["About.Licence.Heading"]</h2>
    <p>@L["About.Licence.Text"]</p>
    <h2>@L["About.Contribute.Heading"]</h2>
    <p>@L["About.Contribute.Text"]</p>
    <h2>@L["About.Repository.Heading"]</h2>
    <p>@L["About.Repository.Text"]</p>
</article>

@code {
    [Parameter]
    public string? Culture { get; set; }

    private CultureKey? _culture;

    protected override void OnInitialized() => _culture = CultureKey.TryCreate(Culture, out CultureKey culture) ? culture : null;

    private static string PathFor(CultureKey culture) => $"/{culture.Value}/about";

    private BreadcrumbItem[] Breadcrumbs(CultureKey culture) =>
    [
        new(L["Breadcrumb.Home"], $"/{culture.Value}"),
        new(L["Breadcrumb.About"], PathFor(culture)),
    ];
}
