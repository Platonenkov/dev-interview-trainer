@inject IStringLocalizer<ClientResource> L

@* Known questions out of the live ones, per topic or per level. The bar is a <meter> (the CSP allows no inline widths)
   and the same numbers are written next to it, so the bar itself is hidden from screen readers. *@
<section class="progress-bars progress-bars--@Kind" aria-labelledby="@HeadingId">
    <h3 class="progress-bars__heading" id="@HeadingId">@Heading</h3>
    <ul class="progress-bars__list">
        @foreach (ProgressBarItem item in Items)
        {
            <li class="progress-bars__item" data-key="@item.Key">
                <span class="progress-bars__name">@item.Title</span>
                <span class="progress-bars__value">@L["Profile.Known", item.Known, item.Live]</span>
                <meter class="progress-bars__meter" min="0" max="@Math.Max(1, item.Live)" value="@item.Known" aria-hidden="true"></meter>
            </li>
        }
    </ul>
</section>

@code {
    /// <summary><c>topics</c> or <c>levels</c>: the CSS modifier and the id prefix.</summary>
    [Parameter, EditorRequired]
    public string Kind { get; set; } = "";

    [Parameter, EditorRequired]
    public string Heading { get; set; } = "";

    [Parameter, EditorRequired]
    public IReadOnlyList<ProgressBarItem> Items { get; set; } = [];

    private string HeadingId => "progress-" + Kind;
}
