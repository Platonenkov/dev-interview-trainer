@using Trainer.Domain.Keys
@using Trainer.Web.Startup
@inject IStringLocalizer<SharedResource> L
@inject SitePaths Paths
<!DOCTYPE html>
<html lang="en" data-edition="static">
<head>
    <StaticHeadMeta />
    @* Right after the policy and the other metas: the encoding must be declared within the first 1024 bytes. *@
    <meta charset="utf-8" />
    <script>@((MarkupString)RecoveryScript.Source)</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@L["Site.Name"]</title>
    <link rel="stylesheet" href="@Paths.Asset(Assets["css/tokens.css"])" data-recover />
    <link rel="stylesheet" href="@Paths.Asset(Assets["css/site.css"])" data-recover />
</head>
<body>
    <SiteUpdatedBanner />
    @* No JavaScript: both links work as they are. root-chooser.js always leaves this page: to the stored language, else the browser's, else English. *@
    <main class="container main">
        <h1>@L["Site.Name"]</h1>
        <nav class="lang-switch" aria-label="@L["Language.Label"]">
            @foreach (CultureKey culture in CultureKey.Supported)
            {
                <a href="@Paths.Page("/" + culture.Value)" lang="@culture.Value" hreflang="@culture.Value">@L[culture.Value == "ru" ? "Language.SwitchToRu" : "Language.SwitchToEn"]</a>
            }
        </nav>
    </main>
    <script src="@Paths.Asset(Assets["js/root-chooser.js"])" data-base="@Paths.BaseHref"></script>
</body>
</html>
