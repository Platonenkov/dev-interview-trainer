@page "/{Culture}/{Stack}/questions"
@using Microsoft.AspNetCore.OutputCaching
@using Microsoft.Extensions.Options
@attribute [OutputCache(PolicyName = "public-catalog")]
@using Trainer.Application.Catalog
@using Trainer.Application.Progress
@using Trainer.Domain.Keys
@using Trainer.Domain.Questions
@using Trainer.Web.Auth
@using Trainer.Web.Catalog
@using Trainer.Web.ContentState
@using Trainer.Web.Seo
@using Trainer.Web.Startup
@inject IStringLocalizer<SharedResource> L
@inject ICatalogQueries Catalogs
@inject IProgressQueries Progress
@inject ContentSnapshotProvider Snapshots
@inject IOptions<AppOptions> App
@inject SitePaths Paths

@if (_query is not null && _page is not null)
{
    <SeoHead Title="@PageTitleText()"
             Description="@L["Catalog.Description"]"
             CanonicalPathAndQuery="@CatalogQueryParser.ToUrl(_query with { Page = _page.Page })"
             AvailableCultures="CultureKey.Supported"
             PathForCulture="c => CatalogQueryParser.ToUrl(_query with { Culture = c, Page = _page.Page })"
             NoIndex="@IsNoIndex()" />
    <BreadcrumbJsonLd Items="Breadcrumbs()" />
    <div class="catalog">
        @if (IsStatic)
        {
            <StaticFilterForm Page="_page" KnownTopics="Snapshots.Current.TopicsOf(_query.Stack.Value)" Culture="@_query.Culture.Value" Stack="@_query.Stack.Value" />
        }
        else
        {
            <FilterPanel Query="_query" Page="_page" />
        }
        <section>
            <h1 class="catalog__heading">@L["Catalog.Heading"]</h1>
            @if (IsStatic)
            {
                @* The template lets catalog-filter.js rewrite the count in the page's language. *@
                <p class="catalog__found" data-found-template="@L["Catalog.Found", "{0}"]">@L["Catalog.Found", _page.Total]</p>
            }
            else
            {
                <p class="catalog__found">@L["Catalog.Found", _page.Total]</p>
            }
            @if (_page.Total > 0)
            {
                <p class="practise-these">
                    <IslandLink Class="btn btn--primary" Href="@PracticeUrl()" PreloadRuntime="true">@L["Practice.These"]</IslandLink>
                </p>
            }
            @if (IsStatic)
            {
                <p data-catalog-empty hidden="@(_page.Rows.Count > 0)">@L["Catalog.Empty"]</p>
                <ol class="rows">
                    @foreach (CatalogRow row in _page.Rows)
                    {
                        <li><QuestionRow Row="row" Culture="@_query.Culture.Value" Stack="@_query.Stack.Value" FilterData="true" /></li>
                    }
                </ol>
            }
            else
            {
                @if (_page.Rows.Count == 0)
                {
                    <p>@L["Catalog.Empty"]</p>
                }
                else
                {
                    <ol class="rows">
                        @foreach (CatalogRow row in _page.Rows)
                        {
                            <li><QuestionRow Row="row" Culture="@_query.Culture.Value" Stack="@_query.Stack.Value" Statuses="_statuses" /></li>
                        }
                    </ol>
                }
                <Pager Query="_query" Page="_page" />
            }
        </section>
    </div>
    @if (IsStatic)
    {
        <script src="@Paths.Asset(Assets["js/catalog-filter.js"])" defer></script>
    }
}

@code {
    [Parameter]
    public string? Culture { get; set; }

    [Parameter]
    public string? Stack { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private CatalogQuery? _query;
    private CatalogPage? _page;
    private IReadOnlyDictionary<QuestionId, QuestionStatus>? _statuses;

    private bool IsStatic => App.Value.Edition == SiteEdition.Static;

    // Combinations beyond one level and one topic, any type filter, every page after the first and every search would
    // only duplicate or dilute the indexable single-selection pages.
    private bool IsNoIndex() =>
        _query!.Levels.Count > 1 || _query.Topics.Count > 1 || _query.Types.Count > 0 || _page!.Page > 1 || _query.Search is not null;

    // The catalog's filters without the page or the search: Practice draws its own random selection from them.
    private string PracticeUrl()
    {
        string query = CatalogQueryParser.ToCanonicalQueryString(_query! with { Page = 1, Search = null });
        string path = $"/{_query!.Culture.Value}/{_query.Stack.Value}/practice";
        return query.Length == 0 ? path : path + "?" + query;
    }

    private string PageTitleText()
    {
        string title = $"{L["Catalog.Heading"]} · {L["Site.Name"]}";
        return _page!.Page > 1 ? L["Catalog.TitlePage", title, _page.Page] : title;
    }

    private BreadcrumbItem[] Breadcrumbs()
    {
        string home = $"/{_query!.Culture.Value}";
        return
        [
            new(L["Breadcrumb.Home"], home),
            new(L["Catalog.Heading"], CatalogQueryParser.ToUrl(new CatalogQuery(_query.Culture, _query.Stack, [], [], [], 1))),
        ];
    }

    protected override async Task OnInitializedAsync()
    {
        // The routing middleware has already answered 404 for an unknown culture or stack, so both parse here.
        if (HttpContext is null || !CultureKey.TryCreate(Culture, out CultureKey culture) || !StackKey.TryCreate(Stack, out StackKey stack))
        {
            return;
        }

        if (IsStatic)
        {
            // A static host cannot run a query: every live row is rendered and catalog-filter.js narrows them, so the
            // request's query string never reaches the server's HTML and the exported page is one file per culture.
            _query = new CatalogQuery(culture, stack, [], [], [], 1);
            _page = await Catalogs.GetAllAsync(culture, stack, HttpContext.RequestAborted);
            return;
        }

        HashSet<TopicKey> knownTopics = [.. Snapshots.Current.TopicsOf(stack.Value).Select(t => new TopicKey(t))];
        _query = CatalogQueryParser.Parse(culture, stack, HttpContext.Request.Query, knownTopics);
        _page = await Catalogs.GetAsync(_query, HttpContext.RequestAborted);
        if (HttpContext.User.GetUserId() is { } user)
        {
            _statuses = await Progress.GetStatusesAsync(user, [.. _page.Rows.Select(r => r.Id)], HttpContext.RequestAborted);
        }
    }
}
