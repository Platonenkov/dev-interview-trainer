@using Trainer.Application.Catalog
@using Trainer.Application.Progress
@using Trainer.Domain.Questions
@inject IStringLocalizer<SharedResource> L

<div class="row">
    <LevelChip Level="Row.Level" />
    <div>
        <a class="row__title" href="/@Culture/@Stack/questions/@Row.Slug">@Row.Title</a>
        <div class="row__meta">@Meta</div>
        @if (Statuses is not null)
        {
            <div class="row__status"><StatusChip Status="@StatusOfRow" /></div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public CatalogRow Row { get; set; } = null!;

    [Parameter, EditorRequired]
    public string Culture { get; set; } = "";

    [Parameter, EditorRequired]
    public string Stack { get; set; } = "";

    /// <summary>The signed-in user's statuses by question; null for an anonymous visitor, which renders no status at all.</summary>
    [Parameter]
    public IReadOnlyDictionary<QuestionId, QuestionStatus>? Statuses { get; set; }

    private QuestionStatus? StatusOfRow => Statuses!.GetValueOrDefault(Row.Id);

    private string Meta => string.Join(" · ", new[] { Row.TopicTitle, L["Type." + QuestionTypeKeys.ToKey(Row.Type)].Value }.Concat(Row.Tags));
}
