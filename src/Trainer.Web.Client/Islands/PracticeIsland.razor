@using System.Text.Json
@using Trainer.Domain.Ids
@using Trainer.Web.Client.Api
@using Trainer.Web.Client.Storage
@using Trainer.Web.Client.Sync
@implements IDisposable
@inject TrainerApiClient Api
@inject OutboxStore Outbox
@inject OutboxSyncService Sync
@inject AccountWatcher Accounts
@inject PracticeFiltersStore FilterStore
@inject KeyboardShortcuts Shortcuts
@inject AnswerFactory Answers
@inject IAnswerGrader Grader
@inject UlidGenerator Ids
@inject ServerClock Clock
@inject TimeProvider Time
@inject IStringLocalizer<ClientResource> L

@* Practice (spec 5.3): filters, then one question at a time with feedback after each answer, then a summary by topic.
   Every answer goes to the owner's outbox first (spec 8.8); a signed-in owner's outbox is flushed in the background. *@
<IslandRoot Usable="_phase != Phase.Loading">
    @if (_bootstrap is { } bootstrap)
    {
        @* data-answers-saved counts the graded answers whose outbox write returned or outlasted its bound; tests wait on it. *@
        @if (_flow.IsSlow)
        {
            <p class="storage-notice practice__slow" role="status">@L["Storage.Slow"]</p>
        }
        <div class="qs" data-answers-saved="@_flow.Saved">
            <TopicSidebar Topics="bootstrap.Topics" Me="bootstrap.Me" CurrentTopic="@CurrentTopic" Culture="@bootstrap.Culture" Stack="@bootstrap.Stack" />
            @* Focusable by script: a fetch from a button (Start, New session, Try again) removes that button, so focus
               waits here meanwhile instead of falling to the body. *@
            <div class="qs__main" tabindex="-1" @ref="_main">
                @switch (_phase)
                {
                    case Phase.Filters:
                        <PracticeFilters Bootstrap="bootstrap" Value="_filters" Start="StartFromFormAsync" />
                        break;
                    case Phase.Loading:
                        <IslandStateView Kind="IslandStateKind.Loading" />
                        break;
                    case Phase.State:
                        <IslandStateView Kind="_state" RetryAfter="_retryAfter" Retry="RetryAsync" ChangeFilters="ShowFilters" />
                        break;
                    case Phase.Question when _session?.Current is { } attempt:
                        <SessionBar Level="@attempt.Question.Level"
                                    TopicTitle="@attempt.Question.TopicTitle"
                                    Position="_session.Index + 1"
                                    Count="_session.Count"
                                    Completed="Completed"
                                    StreakDays="bootstrap.Me?.StreakDays" />
                        <div class="qs__body">
                            <QuestionCard @key="attempt.ClientAnswerId" Attempt="attempt" Changed="StateHasChanged">
                                <AnswerArea Attempt="attempt" Flow="_flow" Graded="SelfGradeAsync" Skip="Skip" Changed="StateHasChanged" />
                            </QuestionCard>
                            @* Rendered before the answer too: its live region must exist, empty, for the verdict to be announced. *@
                            <FeedbackPanel Attempt="attempt" />
                            @if (attempt.IsDone && _owner is { } owner)
                            {
                                <QuestionFeedbackBar @key="attempt.Question.Id" Question="attempt.Question" Owner="owner" Culture="@bootstrap.Culture" InitialRating="@RatingOf(attempt.Question.Id)" />
                            }
                        </div>
                        @if (attempt.IsDone)
                        {
                            <div class="action-bar">
                                <button type="button" class="btn btn--primary practice__next" @ref="_next" @onclick="Next">
                                    @L[_session.Index + 1 == _session.Count ? "Practice.Finish" : "Practice.Next"]
                                    <kbd class="kbd-hint" aria-hidden="true">N</kbd>
                                </button>
                            </div>
                        }
                        else if (attempt.Kind != QuestionKind.SelfAssessed)
                        {
                            <div class="action-bar">
                                <button type="button" class="btn btn--primary practice__answer" disabled="@(!attempt.CanSubmit)" @onclick="SubmitAsync">
                                    @L["Practice.Answer"]
                                    <kbd class="kbd-hint" aria-hidden="true">Enter</kbd>
                                </button>
                            </div>
                        }
                        break;
                    case Phase.Summary when _session is not null:
                        <section class="practice-summary" aria-labelledby="practice-summary-heading">
                            <h2 class="practice-summary__heading" id="practice-summary-heading" tabindex="-1" @ref="_summaryHeading">@L["Practice.Summary.Heading"]</h2>
                            @if (_summary.Count == 0)
                            {
                                <p>@L["Practice.Summary.None"]</p>
                            }
                            @foreach (PracticeTopicSummary topic in _summary)
                            {
                                <section class="practice-summary__topic">
                                    <h3 class="practice-summary__title">@topic.Title</h3>
                                    <p class="practice-summary__counts">@L["Practice.Summary.Counts", topic.Knew, topic.Partial, topic.DidntKnow]</p>
                                    <ul class="practice-summary__list">
                                        @foreach ((QuestionDto question, Grade grade) in topic.Questions)
                                        {
                                            <li>
                                                <a class="practice-summary__link" href="@QuestionHref(question)" data-enhance-nav="false">
                                                    <span class="practice-summary__mark practice-summary__mark--@GradeKeys.ToKey(grade)" aria-hidden="true">@Mark(grade)</span>
                                                    <span>@question.Title</span>
                                                    <span class="visually-hidden">(@GradeLabel(grade))</span>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </section>
                            }
                            <div class="action-bar">
                                <button type="button" class="btn btn--primary practice-summary__new" @onclick="NewSessionAsync">@L["Practice.NewSession"]</button>
                                <button type="button" class="btn" @onclick="ShowFilters">@L["State.ChangeFilters"]</button>
                            </div>
                        </section>
                        break;
                }
            </div>
        </div>
    }
</IslandRoot>

@code {
    // How long Start waits for pending answers to reach the server before it fetches a session that depends on them.
    private static readonly TimeSpan FlushWait = TimeSpan.FromSeconds(5);

    private readonly CancellationTokenSource _lifetime = new();

    private IslandBootstrapDto? _bootstrap;
    private long? _owner;
    private PracticeFilterSet _filters = new([], [], [], PracticeFilterSet.All, PracticeFilterSet.DefaultCount);
    private Phase _phase = Phase.Loading;
    private IslandStateKind _state;
    private TimeSpan? _retryAfter;
    private PracticeSession? _session;
    private IReadOnlyList<PracticeTopicSummary> _summary = [];
    private IReadOnlyDictionary<string, string>? _myRatings;
    private (PracticeFilterSet Filters, string? First, IReadOnlyList<string> Seen) _lastRequest;
    private ElementReference _main;
    private ElementReference _next;
    private ElementReference _summaryHeading;
    private bool _focusMain;
    private bool _focusSummary;
    private bool _fetching;
    private AnsweringFlow _flow = null!;

    /// <summary>The <c>IslandBootstrapDto</c> the server serialised with <c>TrainerJsonContext</c>.</summary>
    [Parameter, EditorRequired]
    public string BootstrapJson { get; set; } = "";

    private enum Phase
    {
        Filters,
        Loading,
        State,
        Question,
        Summary,
    }

    private bool SignedIn => _owner is not null;

    private string OutboxKey => _owner is { } owner ? StorageKeys.UserOutbox(owner) : StorageKeys.AnonymousOutbox;

    private string? CurrentTopic => _filters.Topics.Count == 1 ? _filters.Topics[0] : null;

    private int Completed => _session is null ? 0 : _session.Index + (_session.Current?.IsDone == true ? 1 : 0);

    protected override async Task OnInitializedAsync()
    {
        _flow = new AnsweringFlow(
            new SlowStorage(Time),
            Grader,
            attempt => Answers.Create(attempt, AnswerMode.Practice, null),
            answer => Outbox.AddAsync(OutboxKey, answer).AsTask(),
            () =>
            {
                if (SignedIn)
                {
                    Sync.RequestFlush();
                }
            });
        _flow.SlowChanged += OnSlowChanged;
        _bootstrap = JsonSerializer.Deserialize(BootstrapJson, TrainerJsonContext.Default.IslandBootstrapDto)
            ?? throw new InvalidOperationException("The island bootstrap is empty.");
        _owner = _bootstrap.Me?.TelegramUserId;

        // The watcher first: a sync bound after another tab already switched accounts must not start.
        string pageOwner = _owner is { } owner ? owner.ToString(CultureInfo.InvariantCulture) : AccountWatcher.Anonymous;
        // Reads name the page's account too: the server answers 409 once another tab switched it (ADR 0008).
        Api.BindOwner(pageOwner);
        await Accounts.StartAsync(pageOwner);
        if (_owner is { } bound)
        {
            Sync.Start(bound);
        }

        _filters = PracticeFilterSet.Resolve(_bootstrap, await FilterStore.LoadAsync());
        if (_bootstrap.InitialFilters.FirstQuestionId is { } first)
        {
            await FetchAsync(_filters, first, []);
        }
        else
        {
            _phase = Phase.Filters;
        }
    }

    // Outbox first (spec 8.8): while a graded answer is being written, the screen keeps its pre-answer state, so the
    // verdict never shows (and Next never appears) for an answer a reload could still lose.
    protected override bool ShouldRender() => !_flow.IsSaving;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Shortcuts.Pressed += OnShortcut;
            await Shortcuts.StartAsync();
        }

        if (_focusMain)
        {
            _focusMain = false;
            await _main.FocusAsync();
        }

        if (_phase == Phase.Question && _session?.Current?.IsDone == true && _flow.TakeFocusNext())
        {
            await _next.FocusAsync();
        }

        if (_focusSummary && _phase == Phase.Summary)
        {
            _focusSummary = false;
            await _summaryHeading.FocusAsync();
        }
    }

    public void Dispose()
    {
        Shortcuts.Pressed -= OnShortcut;
        if (_flow is not null)
        {
            _flow.SlowChanged -= OnSlowChanged;
        }

        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private void OnSlowChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task StartFromFormAsync(PracticeFilterSet filters)
    {
        // A double click or a repeated Enter must not fetch (and replace) the session twice.
        if (_fetching)
        {
            return;
        }

        _fetching = true;
        _filters = filters;
        try
        {
            // Remembered only when chosen in the form; a first= link or a retry does not change the user's choice.
            await FilterStore.SaveAsync(filters);
        }
        finally
        {
            _fetching = false;
        }

        await FetchAsync(filters, null, [], moveFocus: true);
    }

    private Task RetryAsync() => FetchAsync(_lastRequest.Filters, _lastRequest.First, _lastRequest.Seen, moveFocus: true);

    // "New session" leaves out what was just shown, in every status; the server applies Exclude to every status.
    private Task NewSessionAsync() => FetchAsync(_filters, null, _session?.SeenIds ?? [], moveFocus: true);

    private void ShowFilters() => _phase = Phase.Filters;

    /// <param name="moveFocus">The fetch was started by a button the loading state removes.</param>
    private async Task FetchAsync(PracticeFilterSet filters, string? first, IReadOnlyList<string> seen, bool moveFocus = false)
    {
        if (_fetching)
        {
            return;
        }

        _fetching = true;
        try
        {
            await FetchOnceAsync(filters, first, seen, moveFocus);
        }
        finally
        {
            _fetching = false;
        }
    }

    private async Task FetchOnceAsync(PracticeFilterSet filters, string? first, IReadOnlyList<string> seen, bool moveFocus)
    {
        IslandBootstrapDto bootstrap = _bootstrap!;
        _lastRequest = (filters, first, seen);
        _phase = Phase.Loading;
        _focusMain = moveFocus;
        StateHasChanged();

        CancellationToken ct = _lifetime.Token;
        if (filters.ReadsServerState(SignedIn))
        {
            // Flush-before-fetch: "new" and "due" are computed from the answers the server has. What does not make it
            // in time stays pending and SyncStatus says so.
            await Sync.FlushAsync(FlushWait, ct);
        }

        IReadOnlyList<AnswerDto>? answeredHere = !SignedIn && string.Equals(filters.Status, PracticeFilterSet.New, StringComparison.Ordinal)
            ? await Outbox.ReadAsync(StorageKeys.AnonymousOutbox)
            : null;
        PracticeSessionRequest request = filters.ToRequest(bootstrap.Culture, bootstrap.Stack, first, PracticeFilterSet.Excluded(seen, answeredHere));
        ApiResult<SessionDto> result = await Api.PracticeAsync(request, ct);

        IslandStateKind kind = IslandState.FromResult(result, result.Value is { Questions.Count: 0 });
        if (kind == IslandStateKind.Ready)
        {
            _myRatings = result.Value!.MyRatings;
            _session = new PracticeSession(result.Value!.Questions, Ids, Random.Shared, Clock);
            _phase = Phase.Question;
        }
        else
        {
            _state = kind;
            _retryAfter = result.RetryAfter;
            _phase = Phase.State;
        }
    }

    private string? RatingOf(string questionId) => _myRatings is not null && _myRatings.TryGetValue(questionId, out string? rating) ? rating : null;

    private Task SubmitAsync() => _flow.SubmitAsync(_session?.Current);

    private Task SelfGradeAsync(Grade grade) => _flow.SelfGradeAsync(_session?.Current, grade, _lifetime.Token);

    private void Skip() => _flow.Skip(_session?.Current);

    private void Next()
    {
        if (_session is null || !_flow.CanGoNext(_session.Current))
        {
            return;
        }

        _session.Next();
        if (_session.IsFinished)
        {
            _summary = PracticeSummary.ByTopic(_session.Results);
            _phase = Phase.Summary;
            _focusSummary = true;
        }
    }

    private void OnShortcut(ShortcutKey key) => _ = InvokeAsync(() => HandleShortcutAsync(key));

    private async Task HandleShortcutAsync(ShortcutKey key)
    {
        if (_phase == Phase.Question && await _flow.HandleShortcutAsync(key, _session?.Current, Next, _lifetime.Token))
        {
            StateHasChanged();
        }
    }

    // Island pages carry <base href="/">, so every link is absolute.
    private string QuestionHref(QuestionDto question) => $"/{_bootstrap!.Culture}/{_bootstrap.Stack}/questions/{question.Slug}";

    private static string Mark(Grade grade) => grade switch
    {
        Grade.Knew => "✓",
        Grade.Partial => "~",
        _ => "✗",
    };

    private string GradeLabel(Grade grade) => grade switch
    {
        Grade.Knew => L["Self.Grade.Knew"].Value,
        Grade.Partial => L["Self.Grade.Partial"].Value,
        _ => L["Self.Grade.DidntKnow"].Value,
    };
}
