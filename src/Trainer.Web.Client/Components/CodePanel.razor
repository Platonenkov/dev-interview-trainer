@inject IStringLocalizer<ClientResource> L

@* Each fragment is a sanitised, self-contained span.line rendered at import; joined by newlines they read as the code. *@
@* The panel scrolls inside itself, so it takes focus: keyboard users can scroll it too. *@
<div class="editor">
    <pre class="code" role="group" tabindex="0" aria-label="@L["Question.Code"]"><code>@((MarkupString)string.Join('\n', LinesHtml))</code></pre>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<string> LinesHtml { get; set; } = [];
}
