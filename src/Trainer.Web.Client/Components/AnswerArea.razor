@* The answer input for one attempt in Practice and Review: options, the line selector, typed output or the
   self-assessment, according to its kind. Verdicts on the options appear once the attempt is done. *@
@switch (Attempt.Kind)
{
    case QuestionKind.FindBug:
        <CodeLineSelector Attempt="Attempt" Changed="Changed" />
        break;
    case QuestionKind.OutputTyped:
        <TypedOutputInput Attempt="Attempt" Changed="Changed" />
        break;
    case QuestionKind.SelfAssessed:
        <SelfAssessment Attempt="Attempt" AllowSkip="true" Saving="() => Flow.IsSaving" Graded="Graded" Skip="Skip" Changed="Changed" />
        break;
    default:
        <OptionList Attempt="Attempt" ShowVerdicts="Attempt.IsDone" Changed="Changed" />
        break;
}

@code {
    [Parameter, EditorRequired]
    public QuestionAttempt Attempt { get; set; } = null!;

    /// <summary>The island's answering flow; the self-assessment reads whether a grade is being saved from it.</summary>
    [Parameter, EditorRequired]
    public AnsweringFlow Flow { get; set; } = null!;

    /// <summary>The user chose a self-grade.</summary>
    [Parameter]
    public EventCallback<Grade> Graded { get; set; }

    [Parameter]
    public EventCallback Skip { get; set; }

    [Parameter]
    public EventCallback Changed { get; set; }
}
