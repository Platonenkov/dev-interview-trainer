[Unit]
Description=Dev Interview Trainer encrypted backup and off-site copy
# Bootstrap enables the timer before the first deployment; the script arrives with the first bundle.
ConditionPathExists=/srv/dev-interview-trainer/current-bundle/remote/backup.sh
After=docker.service

[Service]
Type=oneshot
User=deploy
Environment=APP_DIR=/srv/dev-interview-trainer
ExecStart=/srv/dev-interview-trainer/current-bundle/remote/backup.sh daily
# Waiting for a running deployment is bounded by DIT_LOCK_TIMEOUT (15 min); a dump of this database takes seconds.
TimeoutStartSec=45min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
