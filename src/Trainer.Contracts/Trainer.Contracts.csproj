<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Shared with the WebAssembly client, which is trimmed: every wire type goes through the source-generated TrainerJsonContext. -->
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>
</Project>
