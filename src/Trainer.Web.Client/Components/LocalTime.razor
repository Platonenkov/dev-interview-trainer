@using Trainer.Web.Client.Interop
@inject ILocalTimeFormatter Formatter

@* A moment shown in the device's time zone and the page language; the machine-readable value stays in datetime. *@
<time datetime="@MachineValue">@Formatter.Format(UiLanguage.Current, Value, WithTime)</time>

@code {
    [Parameter, EditorRequired]
    public DateTimeOffset Value { get; set; }

    /// <summary>Hours and minutes after the date (a next review); without it the date alone (a finished mock).</summary>
    [Parameter]
    public bool WithTime { get; set; }

    // The ISO 8601 round-trip form for the datetime attribute: a machine value, not a culture format.
#pragma warning disable RS0030
    private string MachineValue => Value.ToString("O", CultureInfo.InvariantCulture);
#pragma warning restore RS0030
}
