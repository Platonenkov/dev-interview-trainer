@using Trainer.Web.Seo
@inject SiteUrls Urls

@* Rendered in place, not through HeadContent: only one HeadContent per page survives in HeadOutlet, and SeoHead owns it.
   Crawlers read JSON-LD from the body as well. The whole element is markup so the "+" in the type stays literal. *@
@((MarkupString)("<script type=\"application/ld+json\">" + Json() + "</script>"))

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<BreadcrumbItem> Items { get; set; } = [];

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string Json() => BreadcrumbJson.Write(Items, path => Urls.Absolute(HttpContext?.Request, path));
}
