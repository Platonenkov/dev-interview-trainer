@inject IStringLocalizer<ClientResource> L

@* Review's recall step (spec 5.3): a choice question shows its prompt without options and asks whether the user can
   answer; the options, already shuffled by the attempt, appear only after "Show options" (or Enter). *@
<div class="recall" role="group" aria-labelledby="@AskId">
    <p class="recall__ask" id="@AskId">@L["Review.Recall.Ask"]</p>
    <p class="recall__note">@L["Review.Recall.Note"]</p>
</div>
<div class="action-bar">
    <button type="button" class="btn btn--primary recall__show" @onclick="() => Show.InvokeAsync()">
        @L["Review.Recall.Show"]
        <kbd class="kbd-hint" aria-hidden="true">Enter</kbd>
    </button>
</div>

@code {
    /// <summary>The attempt's answer id, so the ids on the page are unique per question.</summary>
    [Parameter, EditorRequired]
    public string AttemptId { get; set; } = "";

    [Parameter]
    public EventCallback Show { get; set; }

    private string AskId => "recall-" + AttemptId;
}
