@using Trainer.Domain.Keys
@using Trainer.Web.Routing
@implements IDisposable
@inject IStringLocalizer<SharedResource> L
@inject PageLinks Links

<nav class="lang-switch" aria-label="@L["Language.Label"]">
    @foreach (CultureKey target in CultureKey.Supported.Where(c => c.Value != Current))
    {
        if (TargetPath(target) is { } href)
        {
            <a href="@href" rel="nofollow" hreflang="@target.Value" lang="@target.Value">@Label(target)</a>
        }
    }
</nav>

@code {
    private string Current => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    protected override void OnInitialized() => Links.Changed += OnLinksChanged;

    public void Dispose() => Links.Changed -= OnLinksChanged;

    // Pages without links (the 404 page) fall back to the culture's home page.
    private string? TargetPath(CultureKey target)
    {
        string? path = Links.IsSet ? Links.PathFor(target) : "/" + target.Value;
        return path is null ? null : LanguageEndpoint.SwitchUrl(target, path);
    }

    private void OnLinksChanged() => _ = InvokeAsync(StateHasChanged);

    private string Label(CultureKey target) => L[target.Value == "ru" ? "Language.SwitchToRu" : "Language.SwitchToEn"];
}
