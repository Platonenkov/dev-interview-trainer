@inject IStringLocalizer<ClientResource> L

@* A status region that exists, empty, before the text is put into it: a live region inserted together with its text is
   often not announced by screen readers. The island renders it once for its whole life and flips Active. *@
<p class="visually-hidden" role="status">@(Active ? L["State.LoadingNext"].Value : "")</p>

@code {
    /// <summary>Whether the next question is loading, so the region carries the text.</summary>
    [Parameter]
    public bool Active { get; set; }
}
