@inject IStringLocalizer<ClientResource> L

<div class="session-bar">
    <span class="level-chip level-@Level">@Level</span>
    <span class="chip">@TopicTitle</span>
    <span class="chip"><span aria-hidden="true">@Position / @Count</span><span class="visually-hidden">@L["Session.Position", Position, Count]</span></span>
    <span class="session-bar__progress">
        @if (StreakDays is { } days)
        {
            <span>@string.Format(CultureInfo.CurrentCulture, L[PluralForms.Key("Session.Streak", days, CultureInfo.CurrentUICulture)].Value, days)</span>
        }
        @* The width comes from the element itself: the CSP allows no inline styles. *@
        <progress max="@Count" value="@Completed" aria-label="@L["Session.Progress"]">@Completed / @Count</progress>
    </span>
</div>

@code {
    /// <summary>The level key (<c>middle</c>); the chip shows the key in every culture, as the public pages do.</summary>
    [Parameter, EditorRequired]
    public string Level { get; set; } = "";

    [Parameter, EditorRequired]
    public string TopicTitle { get; set; } = "";

    /// <summary>The 1-based position of the question on screen.</summary>
    [Parameter]
    public int Position { get; set; }

    [Parameter]
    public int Count { get; set; }

    /// <summary>Questions finished so far; fills the progress bar.</summary>
    [Parameter]
    public int Completed { get; set; }

    /// <summary>From <c>Me</c>; null for anonymous users, who have no streak.</summary>
    [Parameter]
    public int? StreakDays { get; set; }
}
