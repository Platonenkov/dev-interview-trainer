@using Trainer.Web.Client.Storage
@inject IBrowserStore Store
@inject NavigationManager Navigation
@inject IslandLinks Links
@inject IStringLocalizer<ClientResource> L

@* A signed-in island's pointer to the profile's import panel (spec 4, 11.4) while this browser still holds answers
   given before sign-in. It only reads: nothing is imported from here. *@
@if (_pending && Href is { } href)
{
    <p class="island-import-notice"><a href="@href" data-enhance-nav="false">@L["Import.Notice"]</a></p>
}

@code {
    private bool _pending;

    // Island pages are {culture}/{stack}/{mode} under the base href, so the link is base-relative and keeps the page's
    // stack; the profile is per stack (ADR 0010).
    private string? Href
    {
        get
        {
            string[] segments = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Split('/', StringSplitOptions.RemoveEmptyEntries);
            return segments.Length >= 2 ? Links.Page(segments[0], segments[1], ["profile"]) + "#import" : null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // A plain read, never the outbox store's: a corrupt value would make the store quarantine it, which is a write.
        StoredDocument document = StoredDocument.Parse(await Store.ReadAsync(StorageKeys.AnonymousOutbox));
        _pending = document.Kind == StoredKind.Valid && document.Items("answers").Any();
    }
}
