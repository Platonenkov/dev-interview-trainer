@page "/not-found"
@inject IStringLocalizer<SharedResource> L
@inject SitePaths Paths

<PageTitle>@L["NotFound.Title"]</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

<section class="not-found">
    <h1 id="not-found">@L["NotFound.Title"]</h1>
    <p>@L["NotFound.Text"]</p>
    <p><a href="@Paths.Page("/" + CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)">@L["NotFound.HomeLink"]</a></p>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        // Also reached directly and through NavigationManager.NotFound(): never a 200 and never stored by a cache.
        if (HttpContext is { Response.HasStarted: false } context)
        {
            context.Response.StatusCode = StatusCodes.Status404NotFound;
            context.Response.Headers.CacheControl = "no-store";
        }
    }
}
