@* Revealed by islands-start.js when the WebAssembly runtime fails to start; ErrorBoundary only covers components after
   boot. Hidden for everyone else, so it never reaches a reader or a screen reader unless the runtime failed. *@
@inject IStringLocalizer<SharedResource> L
@inject SitePaths Paths

<p class="island-boot-error" role="alert" hidden>
    @L["Island.BootFailed"]
    <a href="@Paths.Page(Href)" data-enhance-nav="false">@L["Island.Reload"]</a>
</p>

@code {
    /// <summary>The page's canonical path and filters, never the raw request URL (it may carry a search term).</summary>
    [Parameter, EditorRequired]
    public string Href { get; set; } = "";
}
