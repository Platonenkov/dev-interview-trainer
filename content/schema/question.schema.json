{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Question",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "stack": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "topic": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "level": {
      "type": "string",
      "enum": [
        "junior",
        "middle",
        "senior",
        "lead",
        "architect"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "open",
        "single",
        "multi",
        "output",
        "find-bug",
        "situation"
      ]
    },
    "grading": {
      "type": "string",
      "enum": [
        "self",
        "auto"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "maxLength": 80
      }
    },
    "code": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "language": {
          "type": "string"
        },
        "harness": {
          "type": "string",
          "enum": [
            "statements",
            "program",
            "none"
          ]
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "language",
        "harness",
        "source"
      ],
      "additionalProperties": false
    },
    "bugLineSets": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "array",
        "items": {
          "type": "integer"
        }
      }
    },
    "fixedSource": {
      "type": [
        "string",
        "null"
      ]
    },
    "fixedExpect": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "output",
            "exception",
            "compile-error",
            "nondeterministic"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "expect": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "output",
            "exception",
            "compile-error",
            "nondeterministic"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "acceptedOutputs": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "options": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "correct": {
            "type": "boolean"
          },
          "expect": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "output",
                  "exception",
                  "compile-error",
                  "nondeterministic"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "correct"
        ],
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "lang": {
            "type": "string",
            "enum": [
              "ru",
              "en"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "docs",
              "spec",
              "article",
              "video",
              "book"
            ]
          }
        },
        "required": [
          "url",
          "lang",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "locales": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "options": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "optionExplanations": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "answer": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "linkTitles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "title",
          "prompt",
          "answer",
          "explanation",
          "linkTitles"
        ],
        "additionalProperties": false
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verified": {
          "type": "string",
          "format": "date"
        },
        "dotnetVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "noRunReason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "authors",
        "verified"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "slug",
    "stack",
    "topic",
    "level",
    "type",
    "grading",
    "tags",
    "links",
    "locales",
    "meta"
  ],
  "additionalProperties": false
}
