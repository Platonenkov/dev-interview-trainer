@inject IStringLocalizer<ClientResource> L

@* One 44 px button per question; the strip scrolls sideways inside itself on phones. The marker says a response exists,
   never whether it is right (no feedback until the end). *@
<nav class="jump" aria-label="@L["Mock.Jump"]">
    <ol class="jump__list">
        @for (int i = 0; i < Session.Attempts.Count; i++)
        {
            int index = i;
            bool answered = MockSession.IsAnswered(Session.Attempts[index]);
            <li>
                <button type="button"
                        class="jump__btn@(answered ? " jump__btn--answered" : "")"
                        aria-current="@(index == Session.Index ? "step" : null)"
                        aria-label="@JumpLabel(index, answered)"
                        @onclick="() => Selected.InvokeAsync(index)">@(index + 1)</button>
            </li>
        }
    </ol>
</nav>

@code {
    [Parameter, EditorRequired]
    public MockSession Session { get; set; } = null!;

    [Parameter]
    public EventCallback<int> Selected { get; set; }

    private string JumpLabel(int index, bool answered)
    {
        string label = L["Mock.Jump.Item", index + 1].Value;
        return answered ? label + ", " + L["Mock.Jump.Answered"].Value : label;
    }
}
