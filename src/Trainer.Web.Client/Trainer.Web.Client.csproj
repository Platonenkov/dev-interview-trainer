<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <!-- Hosted by Trainer.Web; there is no index.html, the server renders the island pages. -->
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- No ICU data or culture data (ADR 0013): resources still follow the culture name, dates are formatted by the
         browser's Intl (LocalTime) and numbers are plain integers. Named cultures must be creatable without data. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <!-- [JSImport] marshalling stubs are generated as unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Only the supported UI cultures; applicationCulture picks one of them at startup (spec 8.3). -->
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Trainer.Domain/Trainer.Domain.csproj" />
    <ProjectReference Include="../Trainer.Contracts/Trainer.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <!-- Culture data does not exist in the client (ADR 0013): BannedSymbols.txt turns culture-sensitive APIs into errors. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>
  <ItemGroup>
    <!-- OutboxSyncService.CurrentAttempt: tests wait for an attempt instead of sleeping. -->
    <InternalsVisibleTo Include="Trainer.Web.Client.Tests" />
  </ItemGroup>
</Project>
